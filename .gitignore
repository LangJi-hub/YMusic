# ── 运行时数据：用户账号 / 会话 / 密钥 / 缓存，绝不可提交 ──
data/

# ── 平台账号凭证（酷狗 / QQ / 网易云登录态）：泄漏等于把账号送人 ──
# 正常位置是 data/secrets.json，已被上面一行覆盖；这里再显式挡一道，
# 防止有人把文件挪到别处（如 ./secrets.json、./cookie.txt）后误提交。
secrets.json
*.cookie
cookie*.txt
.env
.env.*

# ── 下载产物与更新包 ──
downloads/
Downloads/

# ── 运行期状态文件 ──
runtime.json
*.log
logs/

# ── 历史备份与构建产物 ──
*.bak
*.bak-*
_backup/
_backups/
*-backup-*/
web-backup-*/
dist/
*.tar.gz

# ── 依赖与缓存 ──
node_modules/
.cache/

# ── 编辑器与系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# 运行期配置（由 install.sh 或首次启动生成，不含在仓库中）
config.json
